@LIN:L1c:0.2
@CURVE_3POOL_GETY{
  version=1
  repo="curvefi/curve-contract"
  source="contracts/pools/3pool/StableSwap3Pool.vy get_D/get_y"
  license="all_rights_reserved_informational_upstream"
  commit="bae23a2fc9a0302d174ea1ffce8219a44a92149c"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_curve_3pool_newton_gety_128bit"
  note="Not mainnet uint256. N=3 explicit x0,x1,x2. amp is an argument (not a time-ramped pool field). SCALE=1e9 so Ann*S*D fits 128-bit. get_dy dx=0 fail-closes instead of uint256 wrap of xp[j]-y-1."
}

!cgy_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!cgy_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(cgy_u_lt(s, a));
}

!cgy_mask32() -> int {
  ^ 4294967295;
}

!cgy_n() -> int {
  ^ 3;
}

!cgy_close1(a: int, b: int) -> int {
  ?(a >= b) {
    ?(a - b <= 1) { ^ 1; };
    ^ 0;
  };
  ?(b - a <= 1) { ^ 1; };
  ^ 0;
}

!cgy_muldiv_add_part(a: int, b: int, add: int, d: int, want: int) -> int {
  ?(d == 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(a < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(add < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  m32 = cgy_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = cgy_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = cgy_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  lo2 = lo + add;
  hi = hi + cgy_u_add_carry(lo, add);
  lo = lo2;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(cgy_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = cgy_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(q < 0) { ov = 1; };
  ?(want == 2) { ^ ov; };
  ?(want == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!cgy_muldiv(a: int, b: int, d: int) -> int {
  ^ cgy_muldiv_add_part(a, b, 0, d, 0);
}

!cgy_pick(i: int, x0: int, x1: int, x2: int) -> int {
  ?(i == 0) { ^ x0; };
  ?(i == 1) { ^ x1; };
  ?(i == 2) { ^ x2; };
  ^ 0;
}

!cgy_xp_ok(x0: int, x1: int, x2: int, amp: int) -> int {
  ?(amp <= 0) { ^ 0; };
  ?(x0 <= 0) { ^ 0; };
  ?(x1 <= 0) { ^ 0; };
  ?(x2 <= 0) { ^ 0; };
  ^ 1;
}
